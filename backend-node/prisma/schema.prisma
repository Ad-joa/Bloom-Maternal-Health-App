generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                      Int            @id @default(autoincrement())
  name                    String?
  email                   String?        @unique
  hashed_password         String?
  trimester               Int?
  due_date                String?
  is_first_pregnancy      Boolean?
  medical_conditions      String?
  age                     Int?
  weight                  String?
  primary_goal            String?
  dietary_preferences     String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  blood_group             String?
  height                  String?
  last_period_date        String?
  role                    String         @default("mother") // "mother", "nurse", "admin"
  partner_code            String?        @unique
  linked_user_id          Int?
  has_accepted_terms      Boolean        @default(false)
  terms_accepted_at       DateTime?
  symptom_logs            symptom_logs[]
  anc_visits              anc_visits[]
  reminders               reminders[]
  health_alerts           health_alerts[]
}

model symptom_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  symptoms   String?
  severity   String?
  notes      String?
  blood_pressure String?
  weight      Float?
  is_synced   Boolean  @default(true)
  created_at DateTime? @default(now())
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  health_alerts health_alerts[]

  @@index([user_id, created_at(sort: Desc)])
}

model community_posts {
  id         String    @id @default(uuid())
  author     String
  week       Int?
  content    String
  likes      Int       @default(0)
  comments   Int       @default(0)
  created_at DateTime  @default(now())

  @@index([created_at(sort: Desc)])
}

model anc_visits {
  id         Int       @id @default(autoincrement())
  user_id    Int
  date       String
  time       String
  doctor     String?
  notes      String?
  status     String    @default("scheduled") // scheduled, completed, missed
  attendance_status String @default("pending") // pending, attended, missed
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
}

model reminders {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String
  type       String    // medication, hydration, appointment, generic
  time       String    // HH:mm format
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_active])
}

model educational_content {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  category    String   // e.g., "nutrition", "danger_sign", "general"
  trimester   Int?     // 1, 2, 3, or null if applicable to all
  week_start  Int?     // specific week applicability
  week_end    Int?
  created_at  DateTime @default(now())

  @@index([trimester, category])
}

model advisory_rules {
  id              Int      @id @default(autoincrement())
  condition       String   // e.g., "blood_pressure_sys > 140 AND severity == 'high'"
  alert_message   String   // e.g., "Seek immediate medical attention."
  risk_level      String   // "low", "medium", "critical"
  is_active       Boolean  @default(true)
}

model health_alerts {
  id              Int      @id @default(autoincrement())
  user_id         Int
  symptom_log_id  Int?
  alert_message   String
  risk_level      String
  is_resolved     Boolean  @default(false)
  created_at      DateTime @default(now())
  
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  symptom_logs    symptom_logs? @relation(fields: [symptom_log_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id, is_resolved])
}
